<!DOCTYPE html>
<html>
  <head>
    <title>Bookwise — Your personal library</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark" aria-hidden="true">B</span>
          <span>Bookwise</span>
        <% end %>
        <nav class="site-nav" aria-label="Main navigation">
          <%= link_to "Library", root_path, class: "site-nav__link" %>
          <%= link_to "Add a book", new_book_path, class: "button button--small" %>
        </nav>
      </div>
    </header>
    <main class="container page-content">
      <%= yield %>
    </main>
    <footer class="site-footer">
      <div class="container">A little more room for the stories you love.</div>
    </footer>
  </body>
</html>
