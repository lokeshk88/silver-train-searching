<% if notice.present? %>
  <div class="notice" role="status"><%= notice %></div>
<% end %>

<section class="page-heading">
  <div>
    <p class="eyebrow">YOUR PERSONAL COLLECTION</p>
    <h1 class="page-title">The library</h1>
    <p class="page-subtitle">Keep your favorite reads, all in one place.</p>
  </div>
  <%= link_to new_book_path, class: "button" do %>
    <span aria-hidden="true">＋</span> Add a book
  <% end %>
</section>

<section class="library-panel" aria-label="Book library">
  <div class="library-toolbar">
    <div>
      <h2 class="section-title">Your books</h2>
      <p class="section-caption">Browse your collection or search by title.</p>
    </div>
    <%= render "searchform" %>
  </div>

  <div class="table-responsive">
    <table class="table library-table align-middle">
      <thead>
        <tr>
          <th scope="col">Book</th>
          <th scope="col">ISBN</th>
          <th scope="col">Author</th>
          <th scope="col">Year</th>
          <th scope="col">Price</th>
          <th scope="col">Status</th>
          <th scope="col">Genre</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% if @books.any? %>
          <% @books.each do |book| %>
            <%= render book %>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="empty-state">
              <span class="empty-state__icon" aria-hidden="true">↗</span>
              <strong>No books found</strong>
              <span>Try another title, or add your first book to the library.</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
