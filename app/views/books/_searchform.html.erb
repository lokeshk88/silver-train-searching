<%= search_form_for @q, html: { class: "search-form" } do |f| %>
  <%= f.label :name_cont, "Search books", class: "visually-hidden" %>
  <%= f.search_field :name_cont, class: "search-input", placeholder: "Search by title…", autocomplete: "off" %>
  <%= f.submit "Search", class: "button button--search" %>
<% end %>
