
<tr>
  <td class="book-title-cell">
    <%= link_to book.name, book, class: "book-title-link" %>
    <span class="book-id">Book #<%= book.id %></span>
  </td>
  <td class="muted-cell"><%= book.isbn %></td>
  <td><%= book.author %></td>
  <td class="muted-cell"><%= book.year %></td>
  <td><%= book.price.present? ? number_to_currency(book.price) : "—" %></td>
  <td>
    <span class="status-badge <%= book.status? ? "status-badge--available" : "status-badge--unavailable" %>">
      <%= book.status? ? "Available" : "Unavailable" %>
    </span>
  </td>
  <td><span class="genre-label"><%= book.genre.humanize %></span></td>
  <td>
    <div class="row-actions">
      <%= link_to "View", book, class: "text-action" %>
      <%= link_to "Edit", edit_book_path(book), class: "text-action" %>
      <%= button_to "Delete", book, method: :delete, class: "text-action text-action--danger" %>
    </div>
  </td>
</tr>
